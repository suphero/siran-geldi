{
  "name": "qr-wait",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Arayüz web/ altında React + Vite; wrangler dev/deploy önce build alır ve dist/ sunulur
  "build": { "command": "npm run build", "watch_dir": "web" },
  // Sayfalar önce Worker'a gelir: hesaplardan önceki <slug>.qrwait.app adresleri yeni adrese yönlenir (src/index.js PAGES),
  // güvenlik başlıkları (src/guard.js) eklenir
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/join", "/host", "/status", "/admin"] },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "REGISTRY", "class_name": "Registry" },
    { "name": "ACCOUNT", "class_name": "Account" }, // kullanıcı başına bilet bakiyesi (src/billing.js)
    { "name": "VISITOR", "class_name": "Visitor" } // ziyaretçi cihazı başına push aboneliği ve aktif biletler
  ] },
  // Worker panelden plaj-sira → siran-geldi → qr-wait olarak yeniden adlandırıldı; DO verisi ve secret'lar yerinde
  "migrations": [
    { "tag": "v1", "transferred_classes": [
      { "from": "Room", "from_script": "plaj-sira", "to": "Room" },
      { "from": "Registry", "from_script": "plaj-sira", "to": "Registry" }
    ] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] },
    { "tag": "v3", "new_sqlite_classes": ["Visitor"] }
  ],
  // Doğrulama ve şifre sıfırlama e-postaları: Cloudflare Email Service, gönderen alan adı panelde doğrulanmış olmalı
  "send_email": [{ "name": "EMAIL" }],
  // IP başına istek sınırı (src/guard.js limit); period 10 ya da 60 sn olabilir
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }, // giriş, hesap açma, şifre sıfırlama
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } } // sıraya giriş, oda + IP başına
  ],
  "observability": { "enabled": true },
  "workers_dev": true, // alan adı aktif olana kadar ve yedek erişim için açık kalsın
  // DNS'te "@" ve "*" için proxied AAAA 100:: yer tutucu kayıtları var
  // Secret'lar (wrangler secret put), .dev.vars'ta yerel kopyası var:
  //   VAPID_PRIVATE_KEY, ADMIN_PASSWORD (süper yönetici, kullanıcı adı "admin"), TURNSTILE_SECRET,
  //   LEMON_API_KEY, LEMON_WEBHOOK_SECRET (Lemon Squeezy webhook'u: https://qrwait.app/api/lemon, order_created + order_refunded)
  // .dev.vars'ta ayrıca DEV=1: e-posta bağlantıları günlüğe yazılır, sıra listesi önbelleğe alınmaz; LEMON_TEST=1: test siparişleri kabul
  "vars": {
    "BASE_DOMAIN": "qrwait.app",
    "VAPID_PUBLIC_KEY": "BMnLrY7VHICel9RZSt62UEiLxZymXnHinntTM-oeV88iHlXTfWZjrtjTJjE_XSx4_q25hNs9TftLofwDaH-UHC4",
    "MAIL_FROM": "notify@qrwait.app",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFKNZ22SRKQieffD", // widget "QRWait" (managed, qrwait.app); gizli anahtarı TURNSTILE_SECRET
    "LEMON_STORE_ID": "487218", // qr-wait.lemonsqueezy.com
    // Satılan paketler: variant = Lemon Squeezy varyant id'si; price yalnızca gösterim, tahsilat Lemon Squeezy'deki fiyattan
    // (mağaza para birimi USD). Ürünün "Default" varyantı (2188402) satılmaz: webhook'ta bilinmeyen varyant yok sayılır.
    // Fiyatlar /pricing sayfasında ve yönetim ekranında bu listeden gösterilir; "$" ile başlarsa 1000 bilet başı fiyat da hesaplanır.
    // name: paket adının anahtarı, dört dildeki adı web/src/lib/i18n.ts S.packs'te (Başlangıç, İşletme, Sezon, Kurumsal)
    "PACKAGES": [
      { "variant": "2188403", "name": "starter", "tickets": 5000, "price": "$9" },
      { "variant": "2188404", "name": "business", "tickets": 20000, "price": "$25" },
      { "variant": "2188405", "name": "season", "tickets": 50000, "price": "$49" },
      { "variant": "2188406", "name": "enterprise", "tickets": 150000, "price": "$99" }
    ]
  },
  "routes": [
    { "pattern": "qrwait.app", "custom_domain": true }, // DNS kaydını Cloudflare kendisi açar
    { "pattern": "*.qrwait.app/*", "zone_name": "qrwait.app" }
  ]
}
